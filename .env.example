# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored -- never commit real credentials.
#
# Everything else is auto-detected: recipient lists are discovered under
# assets/, and the resume PDF, resume text, and templates are picked up from
# assets/attachments/ and assets/templates/. Only override those below if the
# auto-detection picks the wrong file.

# ============== Required ==============
# Gmail address and an App Password (NOT your account password):
# https://myaccount.google.com/apppasswords
LOGIN_EMAIL="you@example.com"
LOGIN_PASSWORD="xxxx xxxx xxxx xxxx"

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Shown as the From: name and address on every email.
EMAIL_BASE_SENDER_NAME="Your Name"
EMAIL_BASE_SENDER_EMAIL="you@example.com"

# ============== Optional overrides ==============
# EMAIL_BASE_SUBJECT="Developer Position - Job Application"
# EMAIL_BASE_ATTACHMENT_PATH="assets/attachments/Your Name - Resume.pdf"
# EMAIL_BASE_TEMPLATE="assets/templates/email_template.txt"
# EMAIL_BASE_DEFAULT_BODY="assets/templates/default_body.txt"
# EMAIL_PATHS_BLACKLIST_PATH="assets/output/blacklist.json"

# GEMINI_API_MODEL="gemini-3.6-flash"
# GEMINI_API_RESUME_TEXT="assets/attachments/resume_text.txt"
# GEMINI_API_EMAIL_TEMPLATE="assets/templates/email_template.txt"
# GEMINI_API_PROMPT="assets/templates/gemini_prompt.txt"
# Local SearXNG instance from docker-compose.yml (docker compose up -d)
# GEMINI_API_SEARCH_URL="http://localhost:8080/search?q={query}&format=json&categories=general&engines=google,bing"
